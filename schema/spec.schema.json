{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "im-hub/spec.schema.json",
  "title": "im-hub/spec.json (contrato v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "slug", "title", "summary", "status", "category", "stack", "facts", "links", "thumbnail", "shots", "docs"],
  "properties": {
    "version": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "title": { "$ref": "#/$defs/text80" },
    "summary": { "$ref": "#/$defs/text280" },
    "status": { "enum": ["live", "dev", "archived"] },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "tagline", "colors", "fx"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 },
        "name": { "$ref": "#/$defs/text40" },
        "tagline": { "$ref": "#/$defs/text160" },
        "colors": { "$ref": "#/$defs/colors" },
        "fx": { "$ref": "#/$defs/fx" }
      }
    },
    "colors": { "$ref": "#/$defs/colors" },
    "fx": { "$ref": "#/$defs/fx" },
    "stack": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 30 }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "period", "context"],
      "properties": {
        "role": { "$ref": "#/$defs/text80" },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
            "end": { "type": "string", "pattern": "^(\\d{4}-(0[1-9]|1[0-2])|atual)$" }
          }
        },
        "context": { "$ref": "#/$defs/text80" }
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url"],
        "properties": {
          "kind": { "enum": ["case", "demo", "video", "repo", "roadmap", "site", "docs", "play", "view", "benchmark", "dotfiles", "build_log"] },
          "url": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 500 },
          "label": { "$ref": "#/$defs/text40" }
        }
      }
    },
    "thumbnail": { "type": "string", "pattern": "^thumbnail\\.(png|jpg|jpeg|webp)$" },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "caption"],
        "properties": {
          "file": { "type": "string", "pattern": "^shots/[0-9]{2}-[a-z0-9-]+\\.(png|jpg|jpeg|webp)$" },
          "caption": { "$ref": "#/$defs/text80" },
          "format": { "enum": ["desktop", "mobile", "tablet", "wide", "square", "terminal"] }
        }
      }
    },
    "docs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "file"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 30 },
          "file": { "type": "string", "pattern": "^docs/[A-Za-z0-9_.-]+\\.md$" },
          "file_en": { "type": "string", "pattern": "^docs/[A-Za-z0-9_.-]+\\.md$" }
        }
      }
    }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pt"],
      "properties": { "pt": { "type": "string" }, "en": { "type": "string" } }
    },
    "text40": { "allOf": [{ "$ref": "#/$defs/i18n" }, { "properties": { "pt": { "minLength": 1, "maxLength": 40 }, "en": { "maxLength": 40 } } }] },
    "text80": { "allOf": [{ "$ref": "#/$defs/i18n" }, { "properties": { "pt": { "minLength": 1, "maxLength": 80 }, "en": { "maxLength": 80 } } }] },
    "text160": { "allOf": [{ "$ref": "#/$defs/i18n" }, { "properties": { "pt": { "minLength": 1, "maxLength": 160 }, "en": { "maxLength": 160 } } }] },
    "text280": { "allOf": [{ "$ref": "#/$defs/i18n" }, { "properties": { "pt": { "minLength": 1, "maxLength": 280 }, "en": { "maxLength": 280 } } }] },
    "colors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
    },
    "fx": { "enum": ["grid", "pipeline", "circuit", "network", "tiling", "glitch"] }
  }
}
